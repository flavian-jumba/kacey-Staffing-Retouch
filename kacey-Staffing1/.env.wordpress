# WordPress API Configuration
VITE_WORDPRESS_API_URL=https://your-wordpress-site.com/wp-json/wp/v2

# Example URLs:
# For WordPress.com: https://your-site.wordpress.com/wp-json/wp/v2
# For self-hosted: https://yourdomain.com/wp-json/wp/v2
# For subdomain: https://blog.yourdomain.com/wp-json/wp/v2

# Note: Replace with your actual WordPress site URL when you set up WordPress
